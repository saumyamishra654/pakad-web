# Firebase Admin SDK (for FastAPI backend)
# Download service account key from Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT_KEY=/path/to/service-account-key.json
# In docker-compose, the key is mounted read-only from this host path into the
# container at /secrets/firebase.json (FIREBASE_SERVICE_ACCOUNT_KEY is set
# automatically in the compose file — this is only the host-side path).
FIREBASE_KEY_FILE=/path/to/service-account-key.json

# Storage root (local disk path for audio/artifacts)
STORAGE_ROOT=/data

# Google Cloud project (for Firestore)
GOOGLE_CLOUD_PROJECT=your-firebase-project-id

# --- CORS (Plan 010) ---
# Comma-separated list of admitted origins. Set to the deployed Vercel URL in
# production; defaults to the local dev origin if unset.
CORS_ORIGINS=http://localhost:3000

# --- Object storage: Cloudflare R2 / S3-compatible (Plan 007, stem handoff) ---
# Leave R2_BUCKET / R2_ENDPOINT empty to disable remote handoff (dev default).
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# --- Remote GPU stem separation: RunPod Serverless (Plans 008/009) ---
# Set to "true" to offload Demucs to the GPU service instead of running it
# in-process on CPU. Requires R2 (above) for the audio handoff and the two
# STEM_SERVICE_* values below.
USE_REMOTE_STEM_SEPARATION=false
STEM_SERVICE_URL=https://api.runpod.ai/v2/<endpoint-id>
# Shared secret checked (constant-time) by stem-service/handler.py.
STEM_SERVICE_SECRET=
RUNPOD_API_KEY=
# What to do when USE_REMOTE_STEM_SEPARATION is true but the call fails:
# "fail" (default; don't silently run multi-hour CPU Demucs on a long song) or
# "local" (fall back to in-process CPU Demucs).
STEM_FALLBACK=fail

# Hard cap (seconds) on the driver.py subprocess. Leave empty for no cap
# (needed for 30 min-2 hr songs); set an int to restore the old 1-hour cap.
PIPELINE_TIMEOUT_SECONDS=

# Lifetime (seconds) of the signed GET URLs minted for a user's YouTube audio
# delivery buffer (Plan 011).
AUDIO_DELIVERY_TTL_SECONDS=86400
